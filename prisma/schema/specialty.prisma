model Specialties {
  id    String  @id @default(uuid())
  title String
  icon  String

  @@map("specialties")
}

model DoctorSpecialties {
  specialtiesId String
  specialties   Specialties @relation(fields: [specialtiesId], reference : [id])
  doctorId      String

  @@id([specialtiesId,doctorId])
  @@map("doctor_specialties")
}